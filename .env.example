# Copy to .env.local and fill in real values. Never commit .env.local.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Local: printed by `supabase start`. Production: Supabase project settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the browser, never prefix with
# NEXT_PUBLIC_. Used only by the Stripe webhook and trusted admin scripts.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ───────────────────────────────────────────────────────────────────
# Test mode: https://dashboard.stripe.com/test/apikeys (sk_test_...).
# Live mode: switch the Dashboard out of test mode (sk_live_...).
STRIPE_SECRET_KEY=

# Webhook signing secret (whsec_...).
# Local: printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# Production: from the webhook endpoint you create in the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=
